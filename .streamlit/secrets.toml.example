# Uniquement pour Streamlit Cloud (en local, l'app lit déjà ton .env).
# Sur share.streamlit.io : colle ce contenu dans Settings > Secrets. Ne jamais commiter.

[bigquery]
project = "thef1lab"
marts_dataset = "marts"
location = "EU"
# season = 2026   # optionnel : par défaut, la dernière saison chargée

# Colle ici le contenu du JSON du service account (lecture seule recommandée)
[gcp_service_account]
type = "service_account"
project_id = "thef1lab"
private_key_id = "xxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
client_email = "f1-dashboard@thef1lab.iam.gserviceaccount.com"
client_id = "xxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "xxx"
