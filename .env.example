# Copy this file to .env and fill in your values. Never commit the real .env.

GCP_PROJECT_ID=thef1lab
BQ_RAW_DATASET=raw_openf1
BQ_LOCATION=EU

# Path to the service account JSON key (see README for how to create it)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/thef1lab-service-account.json

# Optional: override the season fetched by ingestion (defaults to current year)
# SEASON_YEAR=2026
